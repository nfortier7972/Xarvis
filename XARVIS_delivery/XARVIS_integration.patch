+# ------------------------------------------- SPHEREx image time-lapse (the pipeline in Jonah_Code_File) ---
+# The run takes seconds to minutes, so it is a background job (analysis_jobs.py): POST starts it, the browser polls.
+JOB_ID = re.compile(r"[0-9a-f]{16}")
+PNG_NAME = re.compile(r"[a-z]+_\d{1,5}")
+
+
+@app.route("/api/analysis", methods=["POST"])
+def analysis_start():
+    try:
+        req = analysis_jobs.pipeline().web_request(request.get_json(force=True, silent=True))
+    except ValueError as e:
+        return jsonify({"error": str(e)}), 400
+    except Exception as e:                               # the pipeline (or one of its packages) could not be loaded
+        return jsonify({"error": analysis_jobs.friendly(e)}), 503
+    return jsonify({"job": analysis_jobs.submit(req), "request": req}), 202
+
+
+@app.route("/api/analyses")
+def analyses_done():
+    """Every finished analysis, for the viewer to draw where SPHEREx images have been analysed."""
+    return jsonify({"analyses": analysis_jobs.finished()})
+
+
+@app.route("/api/analysis/<jid>")
+def analysis_status(jid):
+    job = analysis_jobs.status(jid) if JOB_ID.fullmatch(jid) else None
+    if job is None:
+        return jsonify({"error": "unknown job"}), 404
+    return jsonify({"job": jid, **job})
+
+
+@app.route("/api/analysis/<jid>/<name>.png")
+def analysis_image(jid, name):
+    if not JOB_ID.fullmatch(jid) or not PNG_NAME.fullmatch(name):
+        abort(404)
+    return send_from_directory(analysis_jobs.folder(jid), name + ".png", max_age=3600)
+
+
